<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Ігноруємо вкладену папку Data, щоб не було дублікатів -->
		<DefaultItemExcludes>$(DefaultItemExcludes);SurveyPortal.Data\**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- Посилання на пакети -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="2.1.175" />
	</ItemGroup>

	<ItemGroup>
		<!-- Посилання на наші бібліотеки -->
		<!-- Важливо: перевірте, чи імена папок збігаються з вашими реальними -->
		<ProjectReference Include="SurveyPortal.Data\SurveyPortal.Data.csproj" />
		<ProjectReference Include="..\SurveyPortal.Shared\SurveyPortal.Shared.csproj" />
	</ItemGroup>

</Project>