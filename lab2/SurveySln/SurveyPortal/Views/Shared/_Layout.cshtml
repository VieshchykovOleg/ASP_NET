<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Портал для опитувань</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>
    <header class="bg-primary text-white p-3 mb-4 shadow-sm">
        <div class="container-fluid d-flex justify-content-between">
            <span class="h3">Портал для опитувань</span>
            <a asp-controller="SurveySession" asp-action="Index" class="btn btn-light">
                Мої незавершені опитування
            </a>
        </div>
    </header>


    <div class="container-fluid">
        <div class="row">
            <aside class="col-3">
                @await Component.InvokeAsync("NavigationMenu")
            </aside>

            <main class="col-9">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
