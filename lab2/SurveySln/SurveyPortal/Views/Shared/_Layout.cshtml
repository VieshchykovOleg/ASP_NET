<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Портал для опитувань</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>
    <header class="bg-primary text-white p-3 mb-4 shadow-sm">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <div>
                <a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">
                    <span class="h3 mb-0">Портал для опитувань</span>
                </a>

                <a asp-controller="Admin" asp-action="Index"
                   class="btn btn-outline-light btn-sm ms-3">
                    Керування
                </a>
            </div>

            <vc:survey-session-summary />
        </div>
    </header>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                <vc:navigation-menu />
            </div>

            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>