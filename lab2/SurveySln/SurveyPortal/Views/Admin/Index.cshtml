@model IEnumerable<Survey>

    @{
    ViewData["Title"] = "Адмін-панель";
    }

    <div class="container mt-4">
        <h2 class="mb-4">Керування опитуваннями</h2>

        <a asp-action="Create" class="btn btn-primary mb-3">Створити нове опитування</a>

        @if (TempData["message"] != null)
    {
        <div class="alert alert-success">@TempData["message"]</div>
    }

        <table class="table table-bordered table-striped table-hover">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>Назва</th>
                    <th>Категорія</th>
                    <th class="text-end">Рейтинг</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var survey in Model)
            {
                <tr>
                    <td>@survey.SurveyID</td>
                    <td>@survey.Title</td>
                    <td>@survey.Category</td>
                    <td class="text-end">@survey.AverageRating.ToString("F2")</td>

                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@survey.SurveyID"
                           class="btn btn-sm btn-warning">Редагувати</a>

                        <a asp-action="Details" asp-route-id="@survey.SurveyID"
                           class="btn btn-sm btn-info">Деталі</a>

                        <a asp-action="Delete" asp-route-id="@survey.SurveyID"
                           class="btn btn-sm btn-danger">Видалити</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
